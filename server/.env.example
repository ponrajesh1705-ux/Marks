# Gmail SMTP Configuration
# Step 1: Enable 2-Step Verification on your Google Account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate an App Password (select "Mail" and your device)
# Step 4: Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Server port
PORT=3001

# Dry Run Mode: set to "true" to save Excel files locally without sending emails
DRY_RUN=true

# API Key: generate a random string and put the same value in the frontend
# Example: openssl rand -hex 20
API_KEY=change-me-to-a-random-string

